{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <main class="container py-4">
        <h1>{{ title }}</h1>

        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button class="btn btn-primary" type="submit">Save</button>
            <a class="btn btn-secondary" href="{{ path('app_pictures') }}">Cancel</a>
        {{ form_end(form) }}
    </main>
{% endblock %}
