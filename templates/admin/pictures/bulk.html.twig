{% extends 'base.html.twig' %}

{% block title %}Bulk upload{% endblock %}

{% block body %}
    <main class="container py-4"
        data-controller="bulk-upload"
        data-bulk-upload-url-value="{{ path('app_admin_picture_bulk_upload') }}"
        data-bulk-upload-token-value="{{ csrf_token('bulk-pictures') }}"
        data-bulk-upload-today-value="{{ 'now'|date('Y-m-d') }}"
        data-bulk-upload-album-url-value="{{ path('app_admin_album_quick_create') }}"
        data-bulk-upload-album-token-value="{{ csrf_token('quick-album') }}">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>Bulk upload</h1>
            <a class="btn btn-secondary" href="{{ path('app_admin_picture_index') }}">Back to photos</a>
        </div>

        <div class="dropzone mb-3" data-bulk-upload-target="dropzone"
            data-action="dragover->bulk-upload#dragOver dragleave->bulk-upload#dragLeave drop->bulk-upload#drop click->bulk-upload#browse">
            <p class="mb-1 fs-5">Drag and drop photos here</p>
            <p class="mb-0 text-body-secondary">or click to browse (JPEG, PNG, GIF, WebP)</p>
            <input type="file" class="d-none" multiple accept="image/jpeg,image/png,image/gif,image/webp"
                data-bulk-upload-target="input" data-action="change->bulk-upload#pick">
        </div>

        <select class="d-none" data-bulk-upload-target="albumSource">
            <option value="">No album</option>
            {% for album in albums %}
                <option value="{{ album.id }}">{{ album.name }}</option>
            {% endfor %}
            <option value="__new__">+ Add album…</option>
        </select>

        <div class="row g-2 align-items-end mb-3" data-bulk-upload-target="toolbar" hidden>
            <div class="col-md-4">
                <label class="form-label" for="bulk-album-all">Album for all photos</label>
                <select class="form-select" id="bulk-album-all" data-bulk-upload-target="albumAll" data-action="change->bulk-upload#albumChanged" data-previous="">
                    <option value="">No album</option>
                    {% for album in albums %}
                        <option value="{{ album.id }}">{{ album.name }}</option>
                    {% endfor %}
                    <option value="__new__">+ Add album…</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="bulk-date-all">Date for all photos</label>
                <input class="form-control" type="date" id="bulk-date-all" value="{{ 'now'|date('Y-m-d') }}"
                    data-bulk-upload-target="dateAll" data-action="change->bulk-upload#applyDate">
            </div>
            <div class="col-md-4 d-flex gap-2 justify-content-md-end">
                <button type="button" class="btn btn-primary" data-bulk-upload-target="submit" data-action="bulk-upload#upload">Upload all</button>
                <button type="button" class="btn btn-outline-secondary" data-action="bulk-upload#clear">Clear</button>
            </div>
        </div>

        <div class="alert alert-success" data-bulk-upload-target="summary" hidden></div>

        <div class="row row-cols-1 row-cols-lg-2 g-3" data-bulk-upload-target="list"></div>

        <template data-bulk-upload-target="template">
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex gap-3">
                            <img class="bulk-thumb" alt="">
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="small text-body-secondary text-break" data-role="filename"></span>
                                    <button type="button" class="btn-close" aria-label="Remove" data-role="remove"></button>
                                </div>
                                <div class="mb-2">
                                    <input class="form-control form-control-sm" name="title" placeholder="Title" maxlength="25">
                                    <div class="invalid-feedback"></div>
                                </div>
                                <div class="mb-2">
                                    <input class="form-control form-control-sm" name="description" placeholder="Description" maxlength="255">
                                    <div class="invalid-feedback"></div>
                                </div>
                                <div class="mb-2">
                                    <input class="form-control form-control-sm" name="metadata" placeholder="Metadata" maxlength="255">
                                    <div class="invalid-feedback"></div>
                                </div>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <input class="form-control form-control-sm" type="date" name="uploadDate">
                                        <div class="invalid-feedback"></div>
                                    </div>
                                    <div class="col-6" data-role="album-slot">
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                                <div class="mt-2 small" data-role="status"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </template>

        <div class="modal fade" tabindex="-1" aria-labelledby="new-album-title" aria-hidden="true" data-bulk-upload-target="modal">
            <div class="modal-dialog">
                <form class="modal-content" data-action="submit->bulk-upload#saveAlbum" novalidate>
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="new-album-title">New album</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-danger" data-bulk-upload-target="albumError" hidden></div>
                        <div class="mb-3">
                            <label class="form-label" for="new-album-name">Name</label>
                            <input class="form-control" id="new-album-name" maxlength="25" required data-bulk-upload-target="albumName">
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="new-album-description">Description</label>
                            <input class="form-control" id="new-album-description" maxlength="255" required data-bulk-upload-target="albumDescription">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" data-bulk-upload-target="albumSave">Create album</button>
                    </div>
                </form>
            </div>
        </div>
    </main>
{% endblock %}
