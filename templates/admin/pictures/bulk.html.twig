{% extends 'admin/layout.html.twig' %}

{% block title %}Bulk upload{% endblock %}

{% block admin_body %}
    {% set isDispatch = dispatches is defined %}
    <main class="container py-4"
        data-controller="bulk-upload"
        data-bulk-upload-url-value="{{ path(isDispatch ? 'app_admin_picture_dispatch' : 'app_admin_picture_bulk_upload') }}"
        data-bulk-upload-token-value="{{ csrf_token('bulk-pictures') }}"
        data-bulk-upload-today-value="{{ 'now'|date('Y-m-d') }}"
        data-bulk-upload-album-url-value="{{ path('app_admin_album_quick_create') }}"
        data-bulk-upload-album-token-value="{{ csrf_token('quick-album') }}"
        {% if isDispatch %}data-bulk-upload-dispatch-url-value="{{ path('app_admin_picture_dispatch_create') }}"
        data-bulk-upload-dispatch-token-value="{{ csrf_token('dispatch-create') }}"
        data-bulk-upload-dispatch-reset-url-value="{{ path('app_admin_picture_dispatch_reset_code', {id: 0}) }}"
        data-bulk-upload-dispatch-reset-token-value="{{ csrf_token('dispatch-reset') }}"{% endif %}>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>{{ isDispatch ? 'Dispatch bulk upload' : 'Bulk upload' }}</h1>
            <a class="btn btn-secondary" href="{{ path('app_admin_picture_index') }}">Back to photos</a>
        </div>

        {% if isDispatch %}
            <div class="card mb-3"><div class="card-body">
                <label class="form-label" for="dispatch-select">Dispatch</label>
                <select class="form-select mb-3" id="dispatch-select" data-bulk-upload-target="dispatch">
                    <option value="">Select a dispatch</option>
                    {% for dispatch in dispatches %}
                        <option value="{{ dispatch.id }}" data-id-code="{{ dispatch.idCode }}">{{ dispatch.nom }} ({{ dispatch.idCode }})</option>
                    {% endfor %}
                </select>
                <p class="text-body-secondary">Uploading to an existing dispatch generates a new access code and invalidates the previous one.</p>
                <form data-action="submit->bulk-upload#createDispatch">
                    <label class="form-label" for="dispatch-name">Or create a dispatch</label>
                    <div class="d-flex gap-2">
                        <input class="form-control" id="dispatch-name" maxlength="255" required data-bulk-upload-target="dispatchName">
                        <button class="btn btn-outline-primary" type="submit" data-bulk-upload-target="dispatchSave">Create</button>
                    </div>
                </form>
                <div class="alert mt-3 mb-0" hidden data-bulk-upload-target="dispatchMessage"></div>
                <button class="btn btn-warning mt-3" type="button" hidden data-bulk-upload-target="dispatchResetRetry" data-action="bulk-upload#retryDispatchReset">Retry access code generation</button>
                <div data-bulk-upload-target="dispatchCredentials"></div>
            </div></div>
        {% endif %}

        <div class="dropzone mb-3" data-bulk-upload-target="dropzone"
            data-action="dragover->bulk-upload#dragOver dragleave->bulk-upload#dragLeave drop->bulk-upload#drop click->bulk-upload#browse">
            <p class="mb-1 fs-5">Drag and drop photos here</p>
            <p class="mb-0 text-body-secondary">or click to browse (JPEG, PNG, GIF, WebP)</p>
            <input type="file" class="d-none" multiple accept="image/jpeg,image/png,image/gif,image/webp"
                data-bulk-upload-target="input" data-action="change->bulk-upload#pick">
        </div>

        <select class="d-none" data-bulk-upload-target="albumSource">
            <option value="">No album</option>
            {% for album in albums %}
                <option value="{{ album.id }}">{{ album.name }}</option>
            {% endfor %}
            <option value="__new__">+ Add album…</option>
        </select>

        <div class="row g-2 align-items-end mb-3" data-bulk-upload-target="toolbar" hidden>
            <div class="col-md-4">
                <label class="form-label" for="bulk-album-all">Album for all photos</label>
                <select class="form-select" id="bulk-album-all" data-bulk-upload-target="albumAll" data-action="change->bulk-upload#albumChanged" data-previous="">
                    <option value="">No album</option>
                    {% for album in albums %}
                        <option value="{{ album.id }}">{{ album.name }}</option>
                    {% endfor %}
                    <option value="__new__">+ Add album…</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="bulk-date-all">Date for all photos</label>
                <input class="form-control" type="date" id="bulk-date-all" value="{{ 'now'|date('Y-m-d') }}"
                    data-bulk-upload-target="dateAll" data-action="change->bulk-upload#applyDate">
            </div>
            <div class="col-md-4 d-flex gap-2 justify-content-md-end">
                <button type="button" class="btn btn-primary" data-bulk-upload-target="submit" data-action="bulk-upload#upload">Upload all</button>
                <button type="button" class="btn btn-outline-secondary" data-action="bulk-upload#clear">Clear</button>
            </div>
        </div>

        <div class="alert alert-success" data-bulk-upload-target="summary" hidden></div>

        <div class="row row-cols-1 row-cols-lg-2 g-3" data-bulk-upload-target="list"></div>

        <template data-bulk-upload-target="template">
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex gap-3">
                            <img class="bulk-thumb" alt="">
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="small text-body-secondary text-break" data-role="filename"></span>
                                    <button type="button" class="btn-close" aria-label="Remove" data-role="remove"></button>
                                </div>
                                <div class="mb-2">
                                    <input class="form-control form-control-sm" name="title" placeholder="Title" maxlength="25">
                                    <div class="invalid-feedback"></div>
                                </div>
                                <div class="mb-2">
                                    <input class="form-control form-control-sm" name="description" placeholder="Description (optional)" aria-label="Description (optional)" maxlength="255">
                                    <div class="invalid-feedback"></div>
                                </div>
                                <div class="mb-2">
                                    <input class="form-control form-control-sm" name="metadata" placeholder="Metadata (optional)" aria-label="Metadata (optional)" maxlength="255">
                                    <div class="invalid-feedback"></div>
                                </div>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <input class="form-control form-control-sm" type="date" name="uploadDate">
                                        <div class="invalid-feedback"></div>
                                    </div>
                                    <div class="col-6" data-role="album-slot">
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                                <div class="mt-2 small" data-role="status"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </template>

        {% if isDispatch %}
            <div class="modal fade" tabindex="-1" aria-labelledby="dispatch-result-title" aria-hidden="true" data-bulk-upload-target="dispatchResultModal">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title fs-5" id="dispatch-result-title">Dispatch upload complete</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p>All photos were uploaded successfully.</p>
                            <p>Dispatch identifier: <strong data-bulk-upload-target="dispatchResultIdentifier"></strong></p>
                            <p>Access code: <strong data-bulk-upload-target="dispatchResultCode"></strong></p>
                            <p class="mb-0">Save the access code securely; it cannot be recovered later.</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}

        <div class="modal fade" tabindex="-1" aria-labelledby="new-album-title" aria-hidden="true" data-bulk-upload-target="modal">
            <div class="modal-dialog">
                <form class="modal-content" data-action="submit->bulk-upload#saveAlbum" novalidate>
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="new-album-title">New album</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-danger" data-bulk-upload-target="albumError" hidden></div>
                        <div class="mb-3">
                            <label class="form-label" for="new-album-name">Name</label>
                            <input class="form-control" id="new-album-name" maxlength="25" required data-bulk-upload-target="albumName">
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="new-album-description">Description</label>
                            <input class="form-control" id="new-album-description" maxlength="255" required data-bulk-upload-target="albumDescription">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" data-bulk-upload-target="albumSave">Create album</button>
                    </div>
                </form>
            </div>
        </div>
    </main>
{% endblock %}
