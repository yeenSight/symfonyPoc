{% for picture in pictures %}
    <div class="modal fade" id="picture-modal-{{ picture.id }}" tabindex="-1" aria-label="{{ picture.title }}" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content bg-dark text-white">
                <div class="modal-header border-0">
                    <h5 class="modal-title">{{ picture.title }}</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center pt-0">
                    <img class="img-fluid" src="{{ picture.url }}" alt="{{ picture.title }}" style="max-height: 75vh;">
                    <p class="mt-3 mb-0">{{ picture.description }}</p>
                </div>
            </div>
        </div>
    </div>
{% endfor %}