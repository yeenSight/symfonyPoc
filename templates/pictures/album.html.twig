{% extends 'base.html.twig' %}

{% block title %}{{ name }}{% endblock %}

{% block body %}
    <main class="container py-4">
        <a href="{{ path('app_pictures') }}">&larr; All albums</a>
        <div class="d-flex justify-content-between align-items-center my-3">
            <div>
                <h1>{{ name }}</h1>
                <p>{{ description }}</p>
            </div>
            {% if is_granted('IS_AUTHENTICATED') %}
                <div class="d-flex gap-2">
                    {% if album %}
                        <a class="btn btn-outline-secondary" href="{{ path('app_admin_album_edit', {id: album.id}) }}">Edit album</a>
                        <form method="post" action="{{ path('app_admin_album_delete', {id: album.id}) }}" onsubmit="return confirm('Delete this album? Its photos will be kept.');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-album-' ~ album.id) }}">
                            <button class="btn btn-outline-danger" type="submit">Delete album</button>
                        </form>
                    {% endif %}
                    <a class="btn btn-primary" href="{{ path('app_admin_picture_new') }}">Add photo</a>
                </div>
            {% endif %}
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        {% if pictures is empty %}
            <p>This album has no photos yet.</p>
        {% else %}
            <div class="row g-3">
                {% for picture in pictures %}
                    <div class="col-6 col-md-4">
                        <div class="card h-100">
                            <button type="button" class="p-0 border-0 bg-transparent" data-bs-toggle="modal" data-bs-target="#picture-modal-{{ picture.id }}" aria-label="View {{ picture.title }}">
                                <img class="card-img-top" src="{{ picture.url }}" alt="{{ picture.title }}" style="height: 220px; object-fit: cover; cursor: zoom-in;">
                            </button>
                            <div class="card-body">
                                <h5 class="card-title">{{ picture.title }}</h5>
                                <p class="card-text">{{ picture.description }}</p>
                                <small class="text-muted">{{ picture.uploadDate|date('Y-m-d') }}</small>
                            </div>
                            {% if is_granted('IS_AUTHENTICATED') %}
                                <div class="card-footer d-flex gap-2">
                                    <a class="btn btn-secondary btn-sm" href="{{ path('app_admin_picture_edit', {id: picture.id}) }}">Edit</a>
                                    <form method="post" action="{{ path('app_admin_picture_delete', {id: picture.id}) }}" onsubmit="return confirm('Delete this photo?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-picture-' ~ picture.id) }}">
                                        <button class="btn btn-danger btn-sm" type="submit">Delete</button>
                                    </form>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>

            {% for picture in pictures %}
                <div class="modal fade" id="picture-modal-{{ picture.id }}" tabindex="-1" aria-label="{{ picture.title }}" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-xl">
                        <div class="modal-content bg-dark text-white">
                            <div class="modal-header border-0">
                                <h5 class="modal-title">{{ picture.title }}</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body text-center pt-0">
                                <img class="img-fluid" src="{{ picture.url }}" alt="{{ picture.title }}" style="max-height: 75vh;">
                                <p class="mt-3 mb-0">{{ picture.description }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </main>
{% endblock %}
